# Copy this file to .env and fill in your values.
# .env is excluded from git (see .gitignore).

# API connection (service account with least privilege)
DB_SERVER=localhost,1433
DB_NAME=ChurnDB
DB_USER=api_user_ChurnDB
DB_PASSWORD=<api_user_ChurnDB password>

# SQL Server container administrator (used by docker-compose.yml)
MSSQL_SA_PASSWORD=<sa password: 8+ chars, upper, lower, digit, symbol>

# Admin login, used only by database_setup.ipynb to load the data
ADMIN_USER=<your SQL admin login>
ADMIN_PASSWORD=<your SQL admin password>